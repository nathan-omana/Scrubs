# Copy to .env and fill in. Never commit .env.

# ---------- Frontend ----------
# Flask backend URL. Use 127.0.0.1, not localhost: on a Mac, localhost:5000 reaches AirPlay Receiver.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
# 1 = run on in-browser sample data with no backend (public .tech demo)
NEXT_PUBLIC_USE_MOCK=0

# ---------- Backend ----------
PORT=5000
# Browser origins allowed to call the backend (CORS), comma-separated
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- Gemini (paid-tier key: free-tier inputs may be used to improve Google's products) ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------- GLiNER ----------
# A Hugging Face name, or a local folder after you download / fine-tune it
GLINER_MODEL=urchade/gliner_medium-v2.1
# Set to 0 to skip GLiNER (rules only) while you're still setting up
USE_GLINER=1
# After the first download, set to 1 so nothing is fetched from the internet at runtime
HF_HUB_OFFLINE=0

# ---------- TiDB: public BC lexicon (see TIDB_SETUP.md) ----------
# auto = use TiDB if TIDB_HOST is set, else data/lexicon_seed.csv | csv = always CSV | off = no lexicon
LEXICON_SOURCE=auto
TIDB_HOST=
TIDB_PORT=4000
TIDB_DATABASE=scrubin
# The gateway uses the READ-ONLY user:
TIDB_USER=
TIDB_PASSWORD=
# Only needed by scripts/seed_lexicon.py (whoever populates the table):
TIDB_ADMIN_USER=
TIDB_ADMIN_PASSWORD=

# ---------- Snowflake: audit log, decisions and counts only (backend/audit.py) ----------
# Leave SNOWFLAKE_ACCOUNT empty and auditing is off; the app still works.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=SCRUBS
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_WAREHOUSE=
