# Copy to .env and fill in. Never commit .env.

# Frontend: Flask backend URL, and NEXT_PUBLIC_USE_MOCK=1 to run on in-browser sample data with no backend
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
NEXT_PUBLIC_USE_MOCK=0

# Backend: comma-separated origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:3000

TIDB_URL=
VAULT_KEY=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
GEMINI_API_KEY=
